# Optional. When set, indexer/scoring/api use PostgreSQL. When unset, they use the file store under ./data.
DATABASE_URL=postgres://bicora:bicora@localhost:5432/bicora

# Hiro Stacks API (public, rate-limited). An API key raises the limit: https://platform.hiro.so
HIRO_API_URL=https://api.hiro.so
HIRO_API_KEY=

# API server
API_PORT=4000

# Frontend: when set, the dashboard reads live data from the API. When unset it reads the committed snapshot.
API_URL=http://localhost:4000

# Frontend split-domain deployment (set per Vercel project; leave unset for a single origin with /dashboard)
# NEXT_PUBLIC_MODE=site   -> marketing site build (bicora.xyz); dashboard links point at NEXT_PUBLIC_APP_URL
# NEXT_PUBLIC_MODE=app    -> dashboard build served at the root (app.bicora.xyz); site links point at NEXT_PUBLIC_SITE_URL
NEXT_PUBLIC_MODE=
NEXT_PUBLIC_SITE_URL=https://bicora.xyz
NEXT_PUBLIC_APP_URL=https://app.bicora.xyz
