{
  "name": "bicora",
  "version": "0.1.0",
  "private": true,
  "description": "Bicora — risk intelligence prototype for Bitcoin DeFi on Stacks",
  "workspaces": [
    "backend/shared",
    "backend/indexer",
    "backend/scoring-engine",
    "api",
    "frontend/dashboard"
  ],
  "scripts": {
    "index": "npm run start -w @btcfi/indexer",
    "score": "npm run start -w @btcfi/scoring-engine",
    "pipeline": "npm run index && npm run score",
    "api": "npm run start -w @btcfi/api",
    "dashboard": "npm run dev -w @btcfi/dashboard",
    "build": "npm run build -w @btcfi/dashboard",
    "test": "npm run test -w @btcfi/scoring-engine",
    "db:migrate": "node backend/shared/db/migrate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zkzora/Bicora.git"
  },
  "homepage": "https://bicora.xyz"
}
